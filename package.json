{
  "name": "sm-vision-pixel",
  "version": "1.0.0",
  "description": "SM Vision Pixel - Creative Media & Branding Studio Official Full-Stack Website",
  "scripts": {
    "install:all": "npm --prefix server install && npm --prefix client install",
    "init-db": "npm --prefix server run init-db",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm --prefix server start\" \"npm --prefix client dev\"",
    "build": "npm --prefix client run build",
    "test": "npm --prefix server test",
    "start": "node server/server.js"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
