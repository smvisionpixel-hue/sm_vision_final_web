# ========================================================
# SM VISION PIXEL - ENVIRONMENT CONFIGURATION TEMPLATE
# ========================================================

# --- SERVER CONFIGURATION (used in server/.env) ---

# Server Port
PORT=5000

# Client origin for Cross-Origin Resource Sharing (CORS)
CLIENT_URL=http://localhost:5173

# Secret key used for signing JWT tokens for Admin authentication
# In production, change this to a long random secret string!
JWT_SECRET=sm_vision_pixel_jwt_secret_key_change_in_production_998811

# Initial Admin Credentials (used during DB seeding)
ADMIN_DEFAULT_USER=admin@smvisionpixel.com
ADMIN_DEFAULT_PASSWORD=Admin@SMVision2025!

# Optional Resend Email Notifications (leave empty to skip live email sending)
# If provided, new contact inquiries and quote requests will be emailed to your inbox.
RESEND_API_KEY=
RESEND_FROM_EMAIL=notifications@smvisionpixel.com
NOTIFICATION_EMAIL=smvisionpixel@gmail.com

# Form Rate Limiting (Spam Protection)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=50

# --- FRONTEND CONFIGURATION (used in client/.env) ---

# Base URL for API calls. In local development Vite automatically proxies /api to http://localhost:5000
VITE_API_BASE_URL=/api
